# Copie este arquivo para ".env" e ajuste se precisar:  cp .env.example .env

# ---------- App (Expo) ----------
# Endereço do servidor (server.js). Deixe comentado para o app descobrir sozinho:
# no Expo Go ele usa o IP do computador que roda o Expo, na porta 3000.
# Descomente só se o servidor estiver em outro endereço.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# ---------- Servidor e banco (docker-compose) ----------
DB_NAME=foodrush_db
DB_USER=foodrush
DB_PASSWORD=troque_esta_senha
