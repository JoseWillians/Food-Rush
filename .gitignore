# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local
# o arquivo de exemplo deve ir para o repositório (o README manda copiá-lo)
!.env.example

# typescript
*.tsbuildinfo

# Uploads locais de imagens (persistidos via volume Docker)
public/uploads/
!public/uploads/.gitkeep

# generated native folders
/ios
/android

# Privacidade e arquivos de governança/agentes
.codex/
.gemini/
.beads/
graphify-out/
logs/
auth/

# Markdown files: ignora todos exceto README.md (regra universal)
*.md
**/*.md
!README.md
!readme.md
